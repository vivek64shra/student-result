rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Daily class attendance records containing absent student entries
    match /attendance_records/{document=**} {
      allow read, write: if true;
    }

    // Student attendance summary documents
    match /attendance/{document=**} {
      allow read, write: if true;
    }

    // Student directory records
    match /students/{document=**} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{document=**} {
      allow read: if true;
    }
  }
}
